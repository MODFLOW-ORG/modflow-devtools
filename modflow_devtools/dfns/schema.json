    "BlockHeader": {
      "description": "A repeating block's header field, plus whether a missing occurrence means\n\"reuse the prior occurrence's values\" (`period`, e.g.). Nested here rather\nthan a sibling flag on `Block` so it can't be set without a header.\n\nAn `Integer` header is inherently a sequential key -- both `period`'s\n`iper` and `solutiongroup`'s `group_num` are documented as monotonically\nincreasing across occurrences, whether or not they fill forward. It's\nonly what a *gap* in that sequence means that varies.",
      "properties": {
        "field": {
          "discriminator": {
            "mapping": {
              "array": "#/$defs/Array",
              "double": "#/$defs/Double",
              "file": "#/$defs/File",
              "integer": "#/$defs/Integer",
              "keyword": "#/$defs/Keyword",
              "list": "#/$defs/List",
              "record": "#/$defs/Record",
              "string": "#/$defs/String",
              "union": "#/$defs/Union"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Keyword"
            },
            {
              "$ref": "#/$defs/String"
            },
            {
              "$ref": "#/$defs/Integer"
            },
            {
              "$ref": "#/$defs/Double"
            },
            {
